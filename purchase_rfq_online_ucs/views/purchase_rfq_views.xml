<odoo>
    <record id="view_purchase_order_form_inherit_vendor" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.response</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="supply_preview" type="object" string="Supplier Preview" class="oe_stat_button" icon="fa-globe"/>
            </xpath>
            <notebook position="inside">
                <page string="Quotation Online">
                    <group>
                        <field name="vendor_signed_by"/>
                        <field name="vendor_signed_on"/>
                        <field name="vendor_signature" widget="image"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="purchase_order_search_inherit" model="ir.ui.view">
        <field name="name">purchase.order.search.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <filter string="New Quotations" name="new_quotation" domain="[('vendor_response_state','=','sent')]"/>
            </field>
        </field>
    </record>

</odoo>